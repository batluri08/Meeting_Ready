# Copy this file to backend/.env and paste your key after the = sign.
# backend/.env is git-ignored, so the key is never committed.
ANTHROPIC_API_KEY= 
# Embeddings: local (default, no key, text stays on this machine) or voyage (needs VOYAGE_API_KEY and `uv add voyageai`).
# Anthropic has no embedding model; its docs recommend Voyage AI. Re-run ingestion after switching.
EMBED_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-finance-2

# auto = use the model when a key is set, else offline. Set to "offline" to force offline mode.
LLM_MODE=auto
