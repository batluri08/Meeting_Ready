  "cards": [
    {
      "dot": "cyan",
      "title": "Where the data comes from",
      "items": [
        "CRM, core banking, billing, payments ops and the service desk: change data capture (Fivetran or Debezium) into the warehouse",
        "Outlook mail and calendar, Teams transcripts: Microsoft Graph change notifications, from compliance-approved mailboxes",
        "SharePoint documents and research PDFs: layout-aware parser with OCR; raw files kept in object storage",
        "Licensed news feeds (Factiva, Refinitiv): approved sources only, licence terms stored per article",
        "Identity: Entra ID groups, the coverage book and information-barrier lists"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data engineering",
      "items": [
        "Airflow or Dagster orchestrates nightly backfills and streaming updates, with freshness alerts",
        "dbt builds client-360 tables; data-quality tests (dbt or Great Expectations) quarantine bad batches",
        "Client master (MDM) matches on LEI, registration number, domain, then name; a steward reviews unsure matches",
        "Every chunk carries its source permissions and a restricted flag before it is embedded",
        "Same chunking as the prototype; Voyage embeddings; a model change re-embeds into a new, versioned collection"
      ]
    },
    {
      "dot": "violet",
      "title": "Same foundation as the prototype",
      "items": [
        "Supervisor (Opus), 4 agents (structured, email, notes, news) and the commitments check, unchanged",
        "Section writer, verifier and code-built uncertainty panel, unchanged",
        "What changes: tools become MCP servers, Temporal runs the workflow, SQLite becomes the warehouse + PostgreSQL",
        "Trigger: a calendar event starts the briefing 24 hours before the meeting; on-demand still works"
      ]
    },
    {
      "dot": "rose",
      "title": "Access controls (where)",
      "items": [
        "Sign-in with Entra ID; every MCP tool call runs with the banker's own on-behalf-of token",
        "Source permissions copied onto every chunk and filtered inside Qdrant",
        "Warehouse row-level security plus the SQL guard on every generated query",
        "Information barriers enforced in the tools and the index; restricted content only to approved model routes"
      ]
    },
    {
      "dot": "amber",
      "title": "Guardrails",
      "items": [
        "Gateway: name masking, allowed-id schemas, untrusted-text wrapping, budgets and rate limits",
        "Verifier and code-built uncertainty panel, as in the prototype",
        "CRM write-backs and emails stay drafts until a person approves them",
        "OpenTelemetry traces per step; append-only audit trail sent to security monitoring"
      ]
    },
    {
      "dot": "orange",
      "title": "Evaluation and monitoring",
      "items": [
        "Offline evaluation in CI on every change; a failed zero-target check blocks release",
        "Live evaluation whenever a prompt, model or tool changes",
        "RAGAS-style judge (Haiku) on a 5% sample of real briefings, with alerts on drops",
        "Analyst edits, citation clicks and approvals grow the answer key"
      ]
    }
  ]
}