  "cards": [
    {
      "dot": "emerald",
      "title": "1 supervisor, 4 agents, 9 tasks",
      "items": [
        "Structured agent: 5 tasks (profile, signals, changes, deals and actions, opportunities) with SQL and 8 importance rules",
        "Email agent: Haiku reads 120 days of emails for asks, promises and concerns",
        "Notes agent and news agent: hybrid search; flag stale statements and outlets that disagree",
        "Commitments check: code compares client asks with open actions",
        "Supervisor (Opus) plans; section writer (Opus) answers; verifier and uncertainty panel are code. Plain Python thread pool, no agent framework"
      ]
    },
    {
      "dot": "rose",
      "title": "Access controls (where)",
      "items": [
        "API: you only see clients you cover (403 otherwise)",
        "Search: filtered by client and clearance before ranking",
        "SQL guard: every chat query rescoped to one client and your access, read-only",
        "Restricted deals and documents: senior only; analysts see counts",
        "Gateway: restricted content only to approved models"
      ]
    },
    {
      "dot": "amber",
      "title": "Guardrails",
      "items": [
        "Names and emails masked before any prompt leaves; restored only for you",
        "Documents wrapped as untrusted text; injection attempts detected and logged",
        "Outputs may cite only the evidence ids they were given (JSON schema)",
        "Verifier drops any sentence without a valid citation or with a number not in its source",
        "Uncertainty panel built by code; offline fallback if the AI fails; every call audited"
      ]
    },
    {
      "dot": "violet",
      "title": "What evaluation tests, step by step",
      "items": [
        "Ingestion and client matching: 16 planted traps (aliases, look-alike company, duplicates)",
        "Search: 22 labelled questions (recall@5 99%; right document first in chat 96%)",
        "Agents and rules: flags match the answer key; key figures recomputed from raw CSVs",
        "Writer and verifier: 47-fact answer key, 100% cited, RAGAS faithfulness 97% (Haiku judge)",
        "Access and chat: leak scans of outputs, prompts and logs; 4 trick questions; answer relevancy"
      ]
    },
    {
      "dot": "orange",
      "title": "Context management",
      "items": [
        "Writer sees only its own section's evidence, plus known conflicts",
        "Every fact is an id (E1, E2…) with its source; outputs cite ids only",
        "Emails from the last 120 days; notes top 3 plus neighbouring chunks",
        "Chat keeps the client, the briefing's evidence and the last 3 Q&A"
      ]
    },
    {
      "dot": "slate",
      "title": "Retrieval and chunking",
      "items": [
        "Chunks of at most 220 words, one-sentence overlap, split by document type",
        "bge-small embeddings (384-d, local); BM25 + vectors fused with RRF (k=60)",
        "Jina reranker on the top 20, chat only",
        "Vectors kept in SQLite (single source of truth), copied into Qdrant at startup"
      ]
    },
    {
      "dot": "cyan",
      "title": "Tech stack",
      "items": [
        "Python 3.12 (uv), FastAPI, SQLite, qdrant-client, fastembed, rank_bm25, sqlglot, reportlab",
        "Next.js 15, React 19, TypeScript, Tailwind v4",
        "Anthropic API: Opus 5.5 and Haiku 5.5"
      ]
    }
  ]
}